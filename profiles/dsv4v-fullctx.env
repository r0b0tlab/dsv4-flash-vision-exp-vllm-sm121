# DSV4-Flash-Vision-Exp full-context profile (1M window / NIAH capacity)
# batched MUST stay 8192 (v026 measured: 16384 caps KV at ~642k tokens; 32768 fails admission)
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.88
KV_CACHE_DTYPE=nvfp4
SPEC_TOKENS=7
COMPILATION_CONFIG_JSON={"cudagraph_mode":"FULL"}
# unset KV_CACHE_MEMORY_BYTES — auto KV required for the 1M window
